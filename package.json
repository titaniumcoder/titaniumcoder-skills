{
  "name": "titaniumcoder-skills",
  "version": "0.0.1",
  "private": true,
  "description": "titaniumcoder's Agent Skills collection — portable SKILL.md directories usable by any Agent Skills implementation.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "keywords": ["pi-package"],
  "pi": {
    "prompts": ["adapters/pi/*.md"]
  },
  "scripts": {
    "validate": "node scripts/validate-skills.mjs",
    "test": "node --test \"scripts/*.test.mjs\"",
    "lint": "npx -y markdownlint-cli2@0.23.3",
    "sync-rules": "node scripts/sync-rules.mjs"
  }
}